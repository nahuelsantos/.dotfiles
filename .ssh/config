# ~/.ssh/config — managed by nahuelsantos/.dotfiles and symlinked by `stow`.
# Do not edit in place: edit the repo and `stow --restow .` again.
#
# Machine-specific overrides (UseKeychain, proxies, IP changes while travelling)
# belong in ~/.ssh/config.local, which is untracked. It is included first so that
# ssh_config's "first value wins" rule lets it override everything below.

Include ~/.ssh/config.local

Host melee
    HostName 192.168.3.8
    User nahuelsantos
    IdentityFile ~/.ssh/id_ed25519_melee
    IdentitiesOnly yes

Host plunder
    HostName 192.168.3.7
    User nahuelsantos
    IdentityFile ~/.ssh/id_ed25519_plunder
    IdentitiesOnly yes

Host dinky
    HostName 192.168.3.11
    User nahuelsantos
    IdentityFile ~/.ssh/id_ed25519_dinky
    IdentitiesOnly yes
